# Copy to .env and fill in. Never commit .env. All values below are dummies.

ENV=dev

# --- Database (docker-compose builds DATABASE_URL for the app container from these) ---
POSTGRES_USER=atm
POSTGRES_PASSWORD=atm
POSTGRES_DB=ask_the_menu
# Used when running the app or the seed loader outside docker:
DATABASE_URL=postgresql+asyncpg://atm:atm@localhost:5432/ask_the_menu

# --- Server-to-server keys ---
INGEST_API_KEY=change-me-ingest
ADMIN_API_KEY=change-me-admin

# --- CORS: comma-separated origins allowed to call /chat from the browser ---
CORS_ORIGINS=http://localhost:5173,https://menunow.de

# --- Rate limits (Redis). Limits are off when REDIS_URL is empty. docker-compose sets it for
# the app container; this value is for running the app outside docker. ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_SESSION=20
RATE_LIMIT_PER_IP=120
RATE_LIMIT_WINDOW_S=3600

# --- Cache and FAQ routes: cosine similarity needed to answer without generation ---
FAQ_MIN_SIMILARITY=0.85
SEMANTIC_CACHE_MIN_SIMILARITY=0.95

# --- Reranker: none (fused order) or cross-encoder (needs `uv sync --extra rerank`;
# the model downloads from Hugging Face on first start) ---
RERANKER=none
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Langfuse (self-hosted, see docker-compose) ---
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_SALT=change-me-salt
# Tracing is off while these are empty. Create a project at http://localhost:3000 and paste
# its API keys here. Inside docker-compose the app reaches Langfuse at LANGFUSE_HOST.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- LLM ---
# "direct" uses the provider SDKs below; "fake" runs fully offline with deterministic
# hashed embeddings (demos/CI without keys; not semantic).
LLM_BACKEND=direct
ANTHROPIC_API_KEY=sk-ant-dummy
OPENAI_API_KEY=sk-dummy
# Gemini, through its OpenAI-compatible API. Only needed for a "gemini:" model below.
GEMINI_API_KEY=gemini-dummy
# Alias -> "<anthropic|openai|gemini>:<model id>". App code only ever names the alias.
MODEL_MENU_FAST=anthropic:REPLACE_WITH_FAST_MODEL_ID
MODEL_MENU_SMART=anthropic:REPLACE_WITH_SMART_MODEL_ID
MODEL_MENU_BACKUP=openai:REPLACE_WITH_BACKUP_MODEL_ID
# Must return 1536-dimensional vectors (see app/db/models.py EMBEDDING_DIM). Gemini embedding
# models are asked for 1536 dims, e.g. gemini:gemini-embedding-001.
MODEL_MENU_EMBED=openai:REPLACE_WITH_EMBEDDING_MODEL_ID
# USD per million tokens, keyed by the model IDs above. Used for cost_usd and budgets.
MODEL_PRICES={"REPLACE_WITH_FAST_MODEL_ID": {"input_per_mtok": 0, "output_per_mtok": 0}}
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
